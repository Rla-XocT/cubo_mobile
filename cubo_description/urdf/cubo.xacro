<?xml version="1.0" ?>
<robot name="cubo" xmlns:xacro="http://www.ros.org/wiki/xacro">
  <xacro:macro name="insert_robot" params="namespace is_sim">
    <xacro:include filename="$(find cubo_description)/urdf/materials.xacro" />
    <xacro:include filename="$(find cubo_description)/urdf/cubo.trans" />
    <xacro:include filename="$(find cubo_description)/urdf/cubo.gazebo" />
    <xacro:include filename="$(find cubo_description)/urdf/cubo_ros2_control.urdf.xacro" />

    <link name="fixed_base"/>

    <link name="base_link">
      <inertial>
          <origin xyz="-0.004 0.000 0.041" rpy="0 0 0"/>
          <mass value="28.14"/>
          <inertia ixx="0.363967" ixy="0.002789" ixz="0.001543" iyy="0.570563" iyz="-0.000279" izz="0.788194"/>
      </inertial>
      <visual>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <mesh filename="package://cubo_description/meshes/base_link.stl" scale="0.001 0.001 0.001"/>
        </geometry>
        <material name="cubo_silver"/>
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <mesh filename="package://cubo_description/meshes/base_link.stl" scale="0.001 0.001 0.001"/>
        </geometry>
      </collision>
    </link>

    <link name="lift">
      <inertial>
        <origin xyz="-9.18631856758714e-05 0.146812629912676 0.08710089925322241" rpy="0 0 0"/>
        <mass value="10.250168665374813"/>
        <inertia ixx="0.119518" iyy="0.038664" izz="0.145642" ixy="5e-05" iyz="0.000414" ixz="-4e-06"/>
      </inertial>
      <visual>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <mesh filename="package://cubo_description/meshes/lift.stl" scale="0.001 0.001 0.001"/>
        </geometry>
        <material name="cubo_silver"/>
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <mesh filename="package://cubo_description/meshes/lift.stl" scale="0.001 0.001 0.001"/>
        </geometry>
      </collision>
    </link>

    <link name="wheel_l">
      <inertial>
        <origin xyz="0.03563639731480209 -2.88928873216952e-10 3.761487369115246e-07" rpy="0 0 0"/>
        <mass value="2.1569185522943797"/>
        <inertia ixx="0.005268" iyy="0.003293" izz="0.003293" ixy="0.0" iyz="-0.0" ixz="-0.0"/>
      </inertial>
      <visual>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <mesh filename="package://cubo_description/meshes/wheel_l.stl" scale="0.001 0.001 0.001"/>
        </geometry>
        <material name="cubo_silver"/>
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <mesh filename="package://cubo_description/meshes/wheel_l.stl" scale="0.001 0.001 0.001"/>
        </geometry>
      </collision>
    </link>

    <link name="wheel_r">
      <inertial>
        <origin xyz="-0.035636378976420025 2.889289472655107e-10 3.761487369115246e-07" rpy="0 0 0"/>
        <mass value="2.1569185522943797"/>
        <inertia ixx="0.005268" iyy="0.003293" izz="0.003293" ixy="0.0" iyz="0.0" ixz="0.0"/>
      </inertial>
      <visual>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <mesh filename="package://cubo_description/meshes/wheel_r.stl" scale="0.001 0.001 0.001"/>
        </geometry>
        <material name="cubo_silver"/>
