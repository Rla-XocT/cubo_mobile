<?xml version="1.0" ?>
<robot name="cubo" xmlns:xacro="http://www.ros.org/wiki/xacro" >
    <xacro:macro name="insert_gazebo" params="namespace">

    <xacro:property name="body_color" value="Gazebo/Silver" />
    <xacro:property name="body_color2" value="Gazebo/Black" />
    <xacro:property name="body_color3" value="Gazebo/White" />
    <xacro:property name="body_color4" value="Gazebo/Yellow" />

        <gazebo>
            <plugin filename="gz_ros2_control-system" name="gz_ros2_control::GazeboSimROS2ControlPlugin">
                <ros>
                    <namespace>${namespace}</namespace>
                </ros>
                <parameters>$(find cubo_gazebo)/config/controllers_cubo.yaml</parameters>
            </plugin>
            <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
                <render_engine>ogre2</render_engine>
            </plugin>
            <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster">
            </plugin>
        </gazebo>

        <gazebo reference="base_link">
          <material>${body_color3}</material>
          <mu1>0.2</mu1>
          <mu2>0.2</mu2>
          <self_collide>true</self_collide>
          <gravity>true</gravity>
        </gazebo>

        <gazebo reference="lift">
          <material>${body_color2}</material>
          <mu1>0.2</mu1>
          <mu2>0.2</mu2>
          <self_collide>true</self_collide>
        </gazebo>

        <gazebo reference="lift_joint">
            <springStiffness>1200</springStiffness>
        </gazebo>

        <gazebo reference="wheel_l">
            <material>${body_color2}</material>
            <mu1>500</mu1>
            <mu2>500</mu2>
            <kp>10000000.0</kp>
            <kd>1.0</kd>
            <!-- <minDepth>0.001</minDepth> -->
        </gazebo>

        <gazebo reference="wheel_r">
            <material>${body_color2}</material>
            <mu1>500</mu1>
            <mu2>500</mu2>
            <kp>10000000.0</kp>
            <kd>1.0</kd>
            <!-- <minDepth>0.001</minDepth> -->
        </gazebo>

        <gazebo reference="wheel_l">
            <self_collide>0</self_collide>
        </gazebo>

        <gazebo reference="wheel_r">
            <self_collide>0</self_collide>
        </gazebo>

        <gazebo reference="caster_a_1">
          <self_collide>0</self_collide>
            <mu1>0.1</mu1>
            <mu2>0.1</mu2>
            <kp>10000000.0</kp>
            <kd>1.0</kd>
            <!-- <minDepth>0.001</minDepth> -->
        </gazebo>

        <gazebo reference="caster_b_1">
          <self_collide>0</self_collide>
            <mu1>0.1</mu1>
            <mu2>0.1</mu2>
            <kp>10000000.0</kp>
            <kd>1.0</kd>
            <!-- <minDepth>0.001</minDepth> -->
        </gazebo>

        <gazebo reference="caster_c_1">
          <self_collide>0</self_collide>
            <mu1>0.1</mu1>
            <mu2>0.1</mu2>
            <kp>10000000.0</kp>
            <kd>1.0</kd>
            <!-- <minDepth>0.001</minDepth> -->
        </gazebo>

        <gazebo reference="caster_d_1">
          <self_collide>0</self_collide>
            <mu1>0.1</mu1>
            <mu2>0.1</mu2>
            <kp>10000000.0</kp>
            <kd>1.0</kd>
            <!-- <minDepth>0.001</minDepth> -->
        </gazebo>

        <gazebo reference="caster_a_2">
          <self_collide>0</self_collide>
          <material>${body_color4}</material>
          <mu1>0.1</mu1>
          <mu2>0.1</mu2>
          <kp>10000000.0</kp>
          <kd>1.0</kd>
          <!-- <minDepth>0.001</minDepth> -->
        </gazebo>

        <gazebo reference="caster_c_2">
          <self_collide>0</self_collide>
          <material>${body_color4}</material>
          <mu1>0.1</mu1>
          <mu2>0.1</mu2>
          <kp>10000000.0</kp>
          <kd>1.0</kd>
          <!-- <minDepth>0.001</minDepth> -->
        </gazebo>

        <gazebo reference="caster_b_2">
          <self_collide>0</self_collide>
          <material>${body_color4}</material>
          <mu1>0.1</mu1>
          <mu2>0.1</mu2>
          <kp>10000000.0</kp>
          <kd>1.0</kd>
          <!-- <minDepth>0.001</minDepth> -->
        </gazebo>

        <gazebo reference="caster_d_2">
          <self_collide>0</self_collide>
          <material>${body_color4}</material>
          <mu1>0.1</mu1>
          <mu2>0.1</mu2>
          <kp>10000000.0</kp>
          <kd>1.0</kd>
          <!-- <minDepth>0.001</minDepth> -->
        </gazebo>

        <gazebo reference="imu">
          <material>${body_color4}</material>
          <mu1>0.2</mu1>
          <mu2>0.2</mu2>
          <self_collide>true</self_collide>
        </gazebo>

        <gazebo reference="lidar">
          <material>${body_color2}</material>
          <mu1>0.2</mu1>
          <mu2>0.2</mu2>
          <self_collide>true</self_collide>
        </gazebo>

        <gazebo reference="camera">
          <material>${body_color}</material>
          <mu1>0.2</mu1>
          <mu2>0.2</mu2>
          <self_collide>true</self_collide>
        </gazebo>

        <!-- IMU 센서 추가 -->
        <gazebo reference="imu">
            <sensor name="imu" type="imu">
                <update_rate>30</update_rate>
                <topic>imu</topic>
                <imu>
                    <angular_velocity>
                        <x/>
                        <y/>
                        <z/>
                    </angular_velocity>
                    <linear_acceleration>
                        <x/>
                        <y/>
                        <z/>
                    </linear_acceleration>
                </imu>
                <visualize>true</visualize>
            </sensor>
            <!-- IMU Sensor Broadcaster Plugin 추가 -->
            <plugin name="imu_sensor_broadcaster" filename="libimu_sensor_broadcaster.so">
                <ros>
                    <argument>/imu</argument>
                </ros>
            </plugin>
        </gazebo>

        <!-- LiDAR-->
        <gazebo reference="lidar">
            <sensor name='lidar' type='gpu_lidar'>
                <topic>lidar/scan</topic>
                <update_rate>15</update_rate>
                <lidar>
                    <scan>
                        <horizontal>
                            <samples>640</samples>
                            <resolution>1</resolution>
                            <min_angle>-3.0</min_angle>
                            <max_angle>-0.2</max_angle>
                        </horizontal>
                        <vertical>
                            <samples>1</samples>
                            <resolution>0.01</resolution>
                            <min_angle>0</min_angle>
                            <max_angle>0</max_angle>
                        </vertical>
                    </scan>
                    <range>
                        <min>0.45</min>
                        <max>8.0</max>
                        <resolution>0.01</resolution>
                    </range>
                    <noise>
                        <type>gaussian</type>
                        <mean>0.0</mean>
                        <stddev>0.01</stddev>
                    </noise>
                </lidar>

                <alwaysOn>1</alwaysOn>
                <visualize>true</visualize>
            </sensor>
        </gazebo>
    </xacro:macro>
</robot>
